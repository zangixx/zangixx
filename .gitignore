# --- Dependencies ---
node_modules/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment / secrets (NEVER commit) ---
.env
.env.*
!.env.example

# --- TLS material for self-hosting (private keys must never be committed) ---
certs/

# --- Test / coverage ---
coverage/
.nyc_output/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- Build output (none by default) ---
dist/
build/
tmp/

